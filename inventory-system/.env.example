# このファイルを .env にコピーして値を設定してください。

# ===== データベース =====
# 初期はローカル動作優先のため SQLite。本番(Vercel/Supabase)移行時は
# schema.prisma の provider を postgresql に変えて接続文字列を設定。
DATABASE_URL="file:./dev.db"

# ===== 認証 =====
# 本番では必ず強いランダム値に変更（生成例: openssl rand -base64 32）
AUTH_SECRET="please-generate-a-32-char-random-string"
NEXTAUTH_SECRET="please-generate-a-32-char-random-string"
AUTH_TRUST_HOST="true"

# ===== Google Sheets API（取引・棚卸・在庫スナップショット出力） =====
# 推奨: サービスアカウントのJSONを丸ごと貼る
GOOGLE_SERVICE_ACCOUNT_JSON=""
# もしくは個別指定
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# ===== LINE Messaging API（棚卸未実施・在庫ズレ・在庫不足通知） =====
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
