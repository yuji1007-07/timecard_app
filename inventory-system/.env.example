# このファイルを .env にコピーして値を設定してください。

# ===== データベース（PostgreSQL / Supabase・Neon 等） =====
# 本番(Vercel)では Pooled connection を DATABASE_URL に設定。
# prisma db push / migrate などスキーマ操作は Direct connection を DIRECT_URL に設定すると安定。
# 例: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ===== 認証 =====
# 本番では必ず強いランダム値に変更（生成例: openssl rand -base64 32）
AUTH_SECRET="please-generate-a-32-char-random-string"
NEXTAUTH_SECRET="please-generate-a-32-char-random-string"
AUTH_TRUST_HOST="true"

# ===== Google Sheets API（取引・棚卸・在庫スナップショット出力） =====
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# ===== LINE Messaging API（棚卸未実施・在庫ズレ・在庫不足通知） =====
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
