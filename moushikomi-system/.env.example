# このファイルを .env にコピーして値を設定してください。

# ===== データベース（PostgreSQL / 本番は Supabase または Neon） =====
# 本番(Vercel)では「Pooled connection」(pgbouncer)の文字列を使用してください。
# 例: postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 1回限りの初期化(prisma db push)やマイグレーション用の直接接続（Supabase: Direct connection, ポート5432）
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ===== 認証 =====
# 本番では必ず強いランダム値に変更してください（生成例: openssl rand -base64 32）
AUTH_SECRET="please-generate-a-32-char-random-string"
AUTH_TRUST_HOST="true"

# ===== 旧システム（Render / Flask版）からのデータ移行時のみ使用 =====
# npm run migrate:from-render を実行するときに、Render の PostgreSQL 接続文字列を設定
OLD_DATABASE_URL=""
