# このファイルを .env にコピーして値を設定してください。

# データベース（SQLite -> 将来 PostgreSQL/Supabase へ移行可能）
DATABASE_URL="file:./dev.db"

# 認証
AUTH_SECRET="please-generate-a-32-char-random-string"
NEXTAUTH_SECRET="please-generate-a-32-char-random-string"
AUTH_TRUST_HOST="true"

# OpenAI / ChatGPT API（AIフィードバック生成）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Sheets API（報告データ自動出力）
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# LINE Messaging API（未提出・フィードバック通知）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
