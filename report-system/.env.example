# このファイルを .env にコピーして値を設定してください。

# ===== データベース（PostgreSQL / 本番は Neon 等） =====
# 本番(Vercel)では Neon の「Pooled connection」文字列を使用してください。
# ローカル開発や1回限りの初期化(prisma db push / seed)では「Direct connection」文字列を使うと安定します。
# 例: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ===== 認証 =====
# 本番では必ず強いランダム値に変更してください（生成例: openssl rand -base64 32）
AUTH_SECRET="please-generate-a-32-char-random-string"
NEXTAUTH_SECRET="please-generate-a-32-char-random-string"
AUTH_TRUST_HOST="true"

# OpenAI / ChatGPT API（AIフィードバック生成）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Sheets API（報告データ自動出力）
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# LINE Messaging API（未提出・フィードバック通知）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
